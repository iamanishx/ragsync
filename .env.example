# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Portal Configuration
PORTAL_PORT=8787

# Redis Configuration
# Local Docker: redis://redis:6379
# Railway: Use the REDIS_URL from Railway Redis plugin
REDIS_URL=redis://redis:6379

# Qdrant Configuration  
# Local Docker: http://qdrant:6333
# Railway: Use external Qdrant Cloud URL (https://your-cluster.qdrant.tech:443)
QDRANT_URL=http://qdrant:6333

# Security (Optional - for API key encryption)
SECRETS_KEY=your_32_character_encryption_key_here

# Embeddings Configuration (Admin-managed for server)
# Only needed for admin who sets up embeddings
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=BAAI/bge-base-en-v1.5
EMBEDDINGS_DIM=768

# Optional: Hugging Face token for embeddings (free option)
HF_TOKEN=your_huggingface_token

# Railway Environment Detection (auto-set by Railway)
RAILWAY_ENVIRONMENT=development

# Application Settings
NODE_ENV=production

# Vector Database Configuration
QDRANT_URL=http://localhost:6333

# Redis Configuration (for Docker setup)
REDIS_URL=redis://localhost:6379
