TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id

# API Keys (chat via !rag setup is per-user; embeddings are server-managed)
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key
NEWS_API_KEY=your_news_api_key

# Optional: Hugging Face token for better free embeddings (get from https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token

# Centralized Embeddings Configuration (server-managed; one model for everyone)
# Providers: huggingface | google | openai | openrouter
EMBEDDINGS_PROVIDER=google
# If huggingface: pick a sentence embedding model (768-d recommended)
# e.g., BAAI/bge-base-en-v1.5 or intfloat/e5-base-v2
EMBEDDINGS_MODEL=google/text-embedding-004
EMBEDDINGS_DIM=768

# Vector Database Configuration
QDRANT_URL=http://localhost:6333

# Redis Configuration (for Docker setup)
REDIS_URL=redis://localhost:6379
